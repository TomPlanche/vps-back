# Status subdomain for vps-back.
#
# Add this site block to the Caddyfile on the VPS (typically /etc/caddy/Caddyfile),
# then reload with `caddy reload --config /etc/caddy/Caddyfile`.
#
# Every path under the subdomain answers the status report, so
# https://status.tomplanche.com/ and any sub path both work:
#   - plain text in a browser or with curl
#   - JSON when the client sends an `Accept` header asking for it
#
# The endpoint answers 503 when the database is unreachable, which is what an
# external uptime monitor should watch.

status.tomplanche.com {
	encode zstd gzip

	rewrite * /status
	reverse_proxy 127.0.0.1:8000
}
