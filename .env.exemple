# Required
API_KEY=change-me
DATABASE_URL=postgresql://user:password@localhost:5432/vps_back

# Server (optional)
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging (optional)
RUST_LOG=info

# Directory served under /static (optional)
STATIC_DIR=static

# GitHub token for the periodic GitHub stats update (optional, disabled if unset)
# GITHUB_TOKEN=ghp_xxx

# Base URL checked by the /status endpoint (optional)
MIAOU_URL=https://miaou.tomplanche.com
